<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Panels and Background -->
    <SolidColorBrush x:Key="Theme.Vision.Window.Background" Color="#16243A" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.Background" Color="#D026384F" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.HeaderBackground" Color="#702E435D" />
    <SolidColorBrush x:Key="Theme.Vision.Panel.SubtleBackground" Color="#80233750" />
    <SolidColorBrush x:Key="Theme.Vision.ActionBar.Background" Color="#202023" />
    <SolidColorBrush x:Key="Theme.Vision.Viewport.Background" Color="#080F1E" />

    <!-- Borders and Lines -->
    <SolidColorBrush x:Key="Theme.Vision.Border" Color="#405E829E" />
    <SolidColorBrush x:Key="Theme.Vision.Border.Subtle" Color="#2E2E32" />
    <SolidColorBrush x:Key="Theme.Vision.Border.Focus" Color="#60A5FA" />

    <!-- Text Colors -->
    <SolidColorBrush x:Key="Theme.Vision.Text.Primary" Color="#E9F1FC" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Secondary" Color="#B1C3DA" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Muted" Color="#8CA4C1" />
    <SolidColorBrush x:Key="Theme.Vision.Text.Inverse" Color="#0F172A" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="Theme.Vision.Status.Success" Color="#22C55E" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Success.Background" Color="#14532D" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Success.Border" Color="#166534" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Failed" Color="#EF4444" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Failed.Background" Color="#7F1D1D" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Failed.Border" Color="#991B1B" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Running" Color="#38BDF8" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Running.Background" Color="#0C4A6E" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Running.Border" Color="#075985" />

    <SolidColorBrush x:Key="Theme.Vision.Status.Warning" Color="#F59E0B" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Warning.Background" Color="#78350F" />
    <SolidColorBrush x:Key="Theme.Vision.Status.Warning.Border" Color="#92400E" />

    <!-- Canvas and Connection -->
    <SolidColorBrush x:Key="Theme.Vision.Canvas.Background" Color="#B5081426" />
    <SolidColorBrush x:Key="Theme.Vision.Canvas.GridDot" Color="#526789AD" />
    <SolidColorBrush x:Key="Theme.Vision.Connection.Line" Color="#52525B" />
    <SolidColorBrush x:Key="Theme.Vision.Connection.Selected" Color="#60A5FA" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="Theme.Vision.Overlay.Background" Color="#CC000000" />

    <!-- AI Copilot & Modern Semantic Tokens -->
    <SolidColorBrush x:Key="Token.Primary" Color="#3B82F6" />
    <SolidColorBrush x:Key="Token.Surface.Background" Color="#16243A" />
    <SolidColorBrush x:Key="Token.Surface.Card" Color="#EC23364D" />
    <SolidColorBrush x:Key="Token.Surface.Muted" Color="#80344D68" />
    <SolidColorBrush x:Key="Token.Border.Subtle" Color="#405E829E" />
    <SolidColorBrush x:Key="Token.Text.Primary" Color="#E9F1FC" />
    <SolidColorBrush x:Key="Token.Text.Secondary" Color="#B1C3DA" />
    <SolidColorBrush x:Key="Token.Text.Muted" Color="#8CA4C1" />
    <SolidColorBrush x:Key="Token.Status.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Token.Status.Danger.Border" Color="#7F1D1D" />
    <SolidColorBrush x:Key="Token.Status.Danger.Background" Color="#450A0A" />


    <!-- 玻璃主题：每次明暗切换由同一套语义资源驱动。 -->
    <SolidColorBrush x:Key="Glass.Edge" Color="#635A789D" />
    <SolidColorBrush x:Key="Glass.Highlight" Color="#535CA6EC" />
    <SolidColorBrush x:Key="Glass.Focus" Color="#7DCAFF" />
    <SolidColorBrush x:Key="Glass.Hover" Color="#DA264366" />
    <SolidColorBrush x:Key="Glass.Pressed" Color="#E6334F7D" />
    <SolidColorBrush x:Key="Glass.Input" Color="#A5102037" />
    <SolidColorBrush x:Key="Glass.Popup" Color="#FA152740" />
    <Color x:Key="Glass.BackdropStart">#111C33</Color>
    <SolidColorBrush x:Key="Glass.Caption" Color="{StaticResource Glass.BackdropStart}" />
    <SolidColorBrush x:Key="Glass.Orb.Blue" Color="#304381DE" />
    <SolidColorBrush x:Key="Glass.Orb.Mint" Color="#2029A7AE" />
    <SolidColorBrush x:Key="Glass.Orb.Violet" Color="#285F54B5" />
    <LinearGradientBrush x:Key="Glass.Backdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Glass.BackdropStart}" Offset="0" />
        <GradientStop Color="#091726" Offset="0.52" />
        <GradientStop Color="#191932" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glass.Surface" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D6233958" Offset="0" />
        <GradientStop Color="#D013253D" Offset="0.52" />
        <GradientStop Color="#C7192B46" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glass.Button" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DD2B4263" Offset="0" />
        <GradientStop Color="#AD182B45" Offset="0.52" />
        <GradientStop Color="#C3223755" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Glass.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1761CA" Offset="0" />
        <GradientStop Color="#2459C6" Offset="0.52" />
        <GradientStop Color="#4E43C5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Glass.Inset" Color="#9C071426" />
    <SolidColorBrush x:Key="Glass.Viewfinder" Color="#637BADD4" />
    <SolidColorBrush x:Key="Glass.ViewfinderText" Color="#9EB4D3" />
    <RadialGradientBrush x:Key="Glass.AmbientBlue" GradientOrigin="0.24,0.22" Center="0.25,0.25"
                         RadiusX="0.76" RadiusY="0.75">
        <GradientStop Color="#454681DB" Offset="0" />
        <GradientStop Color="#198978FA" Offset="0.48" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Glass.AmbientMint" GradientOrigin="0.85,0.63" Center="0.82,0.65"
                         RadiusX="0.64" RadiusY="0.84">
        <GradientStop Color="#2837B9B2" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Glass.Rim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#554A9BFF" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.85" />
    </LinearGradientBrush>
</ResourceDictionary>
