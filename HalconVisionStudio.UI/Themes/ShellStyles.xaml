<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HalconVisionStudio.UI;component/Themes/GlassStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="PanelBorderStyle" BasedOn="{StaticResource GlassPanelStyle}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Glass.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" BasedOn="{StaticResource GlassIconButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="SchemeButtonStyle" BasedOn="{StaticResource GlassIconButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="ToolbarIconPathStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="Stroke" Value="{DynamicResource Theme.Vision.Text.Primary}" />
    </Style>
</ResourceDictionary>
