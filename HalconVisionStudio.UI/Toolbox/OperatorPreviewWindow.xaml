<Window
    x:Class="HalconVisionStudio.UI.Controls.OperatorPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="算子预览"
    Width="780"
    Height="660"
    MinWidth="520"
    MinHeight="380"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    FontFamily="Microsoft YaHei UI"
    FontSize="13"
    Background="{DynamicResource Glass.Backdrop}"
    Foreground="{DynamicResource Theme.Vision.Text.Primary}">

    <Window.Resources>
        <Style x:Key="PreviewDescription" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Secondary}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewTabStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="TabSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Glass.Input}"
                            BorderBrush="{DynamicResource Glass.Edge}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Glass.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Glass.Pressed}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Glass.Focus}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Glass.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ParameterPreviewTemplate">
            <Border
                Margin="0,0,0,7"
                Padding="12,8"
                Style="{StaticResource GlassDockStyle}">
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="11"
                        Text="{Binding Info}"
                        Style="{StaticResource PreviewDescription}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="{Binding Description, TargetNullValue=''}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="11"
                        Text="{Binding Details}"
                        Style="{StaticResource PreviewDescription}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NativeOperatorTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,9" Margin="0,0,0,10" Style="{StaticResource GlassDockStyle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0">
                                <Hyperlink
                                    Foreground="{DynamicResource Glass.Focus}"
                                    NavigateUri="{Binding ReferenceUri}"
                                    RequestNavigate="ReferenceLink_RequestNavigate">
                                    MVTec 官方文档
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding DotNetName}" FontFamily="Consolas" />
                        </DockPanel>
                        <TextBox
                            Margin="0,6,0,0"
                            Padding="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            IsReadOnly="True"
                            FontFamily="Consolas"
                            AutomationProperties.Name="HDevelop 调用签名"
                            Text="{Binding Signature, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemsSource="{Binding Parameters}"
                        ItemTemplate="{StaticResource ParameterPreviewTemplate}" />
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,13">
            <Border DockPanel.Dock="Left" Style="{StaticResource GlassSectionIconStyle}">
                <Path
                    Width="17"
                    Height="17"
                    Data="{Binding Icon}"
                    Stretch="Uniform"
                    Stroke="{DynamicResource Glass.Focus}"
                    StrokeThickness="1.6"
                    StrokeLineJoin="Round" />
            </Border>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Text="{Binding Description}"
                    Style="{StaticResource PreviewDescription}" />
            </StackPanel>
        </DockPanel>

        <TabControl
            Grid.Row="1"
            Padding="10"
            Background="{DynamicResource Glass.Surface}"
            BorderBrush="{DynamicResource Glass.Edge}"
            ItemContainerStyle="{StaticResource PreviewTabStyle}">
            <TabItem Header="HALCON 原始算子">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{Binding Note, TargetNullValue=''}"
                        Style="{StaticResource PreviewDescription}" />

                    <ComboBox
                        x:Name="NativeOperatorPicker"
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        MinHeight="32"
                        AutomationProperties.Name="HALCON 原始算子"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Calls}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <ContentControl
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding SelectedItem, ElementName=NativeOperatorPicker}"
                        ContentTemplate="{StaticResource NativeOperatorTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </TabItem>

            <TabItem Header="VisionFlow 节点参数">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="NodeParameterList"
                            ItemsSource="{Binding NodeParameters}"
                            ItemTemplate="{StaticResource ParameterPreviewTemplate}" />
                    </ScrollViewer>
                    <TextBlock
                        Text="此节点没有可预览的配置参数。"
                        Foreground="{DynamicResource Theme.Vision.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=NodeParameterList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>

        <Button
            Grid.Row="2"
            MinWidth="84"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Content="关闭"
            IsCancel="True"
            Style="{StaticResource GlassButtonStyle}" />
    </Grid>
</Window>
