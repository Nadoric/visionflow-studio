<mahs:MetroWindow
    x:Class="HalconVisionStudio.Views.Logs.ExecutionLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls"
    Title="执行日志"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    FontFamily="Microsoft YaHei UI"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
    <mahs:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HalconVisionStudio.Shared;component/Themes/PluginDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mahs:MetroWindow.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="导出当前列表" Click="OnExport" Margin="8,0,0,0"
                        Style="{StaticResource Plugin.Button.Primary}" />
                <Button Content="打开日志目录" Click="OnOpenDirectory" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ComboBox x:Name="CategoryBox" Width="110" Margin="0,0,8,0"
                          Style="{StaticResource Plugin.ComboBox}"
                          SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="LevelBox" Width="90" Margin="0,0,8,0"
                          Style="{StaticResource Plugin.ComboBox}"
                          SelectionChanged="OnFilterChanged" />
            </StackPanel>
            <TextBox x:Name="SearchBox" MinWidth="160"
                     Style="{StaticResource Plugin.TextBox}"
                     mahs:TextBoxHelper.Watermark="搜索作用域、摘要或详情"
                     TextChanged="OnFilterChanged" />
        </DockPanel>

        <DataGrid Grid.Row="1" x:Name="LogGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                  EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LevelText}" Value="错误">
                            <Setter Property="Foreground" Value="#E5484D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="警告">
                            <Setter Property="Foreground" Value="#B87900" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间"
                                    Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                    Width="110" />
                <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="60" />
                <DataGridTextColumn Header="类别" Binding="{Binding CategoryText}" Width="70" />
                <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" Width="150" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Message}" Width="*" />
                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" />
        <TextBox Grid.Row="3" x:Name="DetailBox" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource Plugin.TextBox}" />
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,10,0,0"
                   Style="{StaticResource Plugin.Hint}" />
    </Grid>
</mahs:MetroWindow>
