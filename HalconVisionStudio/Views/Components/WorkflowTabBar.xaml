<UserControl
    x:Class="HalconVisionStudio.Views.Components.WorkflowTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 标签列表受剩余宽度约束，多个流程时横向滚动，运行按钮始终可见。 -->
        <Grid Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="工作流" Margin="0,0,10,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource Theme.Vision.Text.Secondary}" />
            <Border Grid.Column="1" Style="{StaticResource GlassDockStyle}" Padding="3,2">
                <ListBox ItemsSource="{Binding Workflows}"
                         SelectedItem="{Binding ActiveWorkflow, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,5,0" />
                            <Setter Property="Padding" Value="12,7" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Secondary}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tab" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,0,8,0"
                                                         Fill="{DynamicResource Theme.Vision.Text.Muted}" />
                                                <TextBlock Text="{Binding WorkflowName}" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Glass.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Glass.Pressed}" />
                                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Glass.Focus}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Text.Primary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Glass.Focus}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Command="{Binding AddWorkflowCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                        Width="30" Height="30" Margin="0,0,4,0" ToolTip="新建工作流 (Ctrl+T)">
                    <Path Width="12" Height="12" Data="{StaticResource Icon.Add}"
                          Style="{StaticResource ToolbarIconPathStyle}" />
                </Button>
                <Button Command="{Binding RemoveWorkflowCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                        Width="30" Height="30" ToolTip="删除当前工作流">
                    <Path Width="12" Height="12" Data="{StaticResource Icon.Remove}"
                          Style="{StaticResource ToolbarIconPathStyle}" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding UndoCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                    Margin="0,0,5,0" ToolTip="撤销 (Ctrl+Z)">
                <Path Width="14" Height="14" Data="{StaticResource Icon.Undo}"
                      Style="{StaticResource ToolbarIconPathStyle}" />
            </Button>
            <Button Command="{Binding RedoCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                    ToolTip="重做 (Ctrl+Y)">
                <Path Width="14" Height="14" Data="{StaticResource Icon.Redo}"
                      Style="{StaticResource ToolbarIconPathStyle}" />
            </Button>
            <Separator Style="{StaticResource CommandBarSeparatorStyle}" Margin="10,0" />
            <Button Command="{Binding HandleExecCommand}" Style="{StaticResource GlassButtonStyle}"
                    Margin="0,0,6,0" ToolTip="执行选中节点 (F6)">
                <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Data="M3,2 L10,7 L3,12 Z M12,2 V12"
                          Style="{StaticResource ToolbarIconPathStyle}" />
                    <TextBlock Text="单步" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding StartProcessCommand}" Style="{StaticResource GlassPrimaryButtonStyle}"
                    Margin="0,0,6,0" ToolTip="运行当前工作流 (F5)">
                <StackPanel Orientation="Horizontal">
                    <Path Width="11" Height="12" Data="{StaticResource Icon.Run}" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="运行流程" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ToggleContinuousRunCommand}" Margin="0,0,6,0"
                    ToolTip="开始或停止连续运行 (F7)">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsContinuousRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.Vision.Status.Warning.Background}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Vision.Status.Warning}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Vision.Status.Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Data="{StaticResource Icon.Loop}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Style="{StaticResource ToolbarIconPathStyle}" />
                    <TextBlock Text="{Binding ContinuousRunButtonText}" Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding StopExecutionCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                    Foreground="{DynamicResource Theme.Vision.Status.Failed}" ToolTip="停止运行 (Shift+F5)">
                <Path Width="10" Height="10" Data="{StaticResource Icon.Stop}" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
