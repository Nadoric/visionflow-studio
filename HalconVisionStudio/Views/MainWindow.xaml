<Window
    x:Class="HalconVisionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HalconVisionStudio.UI.Controls;assembly=HalconVisionStudio.UI"
    xmlns:components="clr-namespace:HalconVisionStudio.Views.Components"
    xmlns:views="clr-namespace:HalconVisionStudio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HalconVisionStudio"
    xmlns:mahs="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="VisionFlow"
    Width="1480"
    Height="900"
    MinWidth="1080"
    MinHeight="700"
    d:DataContext="{d:DesignInstance Type={x:Type local:MainViewModel}}"
    Background="{DynamicResource Glass.Backdrop}"
    Icon="pack://application:,,,/HalconVisionStudio;component/Assets/VisionFlow.ico"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    BorderBrush="{DynamicResource Glass.Edge}"
    BorderThickness="1"
    FontFamily="Microsoft YaHei UI"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding AutoLayoutCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="VerticalPaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle
                                x:Name="SplitterLine"
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{DynamicResource Glass.Edge}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalPaneSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle
                                x:Name="SplitterLine"
                                Height="1"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Glass.Edge}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Height" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Height" Value="2" />
                                <Setter TargetName="SplitterLine" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14,10,14,7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Border Background="{DynamicResource Glass.AmbientBlue}" />
            <Border Background="{DynamicResource Glass.AmbientMint}" />
        </Grid>

        <Border Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource GlassPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Border Height="1" VerticalAlignment="Top" Margin="18,0"
                        Background="{DynamicResource Glass.Rim}" IsHitTestVisible="False" />
                <components:MainMenuBar Grid.Row="0" />
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Glass.Edge}">
                    <components:WorkflowTabBar Margin="14,5" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto"
                    MinWidth="52"
                    MaxWidth="264" />
                <ColumnDefinition Width="1.4*" MinWidth="315" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource GlassPanelStyle}">
                <controls:ToolboxPanel IsExpanded="True" AddNodeCommand="{Binding AddNodeCommand}"
                                       ItemsSource="{Binding HandleControl.HandleView}" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <controls:WorkflowEditor
                    AddNodeCommand="{Binding AddNodeCommand}"
                    AutoLayoutCommand="{Binding AutoLayoutCommand}"
                    LayoutRevision="{Binding WorkflowLayoutRevision}"
                    ConnectNodesCommand="{Binding AddConnectionCommand}"
                    Connections="{Binding Connections}"
                    DeleteConnectionCommand="{Binding DeleteConnectionCommand}"
                    DeleteSelectedConnectionCommand="{Binding DeleteSelectedConnectionCommand}"
                    MoveNodeCommand="{Binding MoveNodeCommand}"
                    NodeDeleteCommand="{Binding DeleteNodeCommand}"
                    NodeEditCommand="{Binding HandleEditCommand}"
                    NodeExecuteCommand="{Binding HandleExecCommand}"
                    NodeConditionCommand="{Binding SetNodeConditionCommand}"
                    Nodes="{Binding Nodes}"
                    SelectConnectionCommand="{Binding SelectConnectionCommand}"
                    RedoCommand="{Binding RedoCommand}"
                    SelectNodeCommand="{Binding SelectNodeCommand}"
                    SetInputBindingCommand="{Binding SetInputBindingCommand}"
                    StopExecutionCommand="{Binding StopExecutionCommand}"
                    UndoCommand="{Binding UndoCommand}"
                    WorkflowScale="{Binding WorkflowScale}" />
            </Border>

            <GridSplitter
                Grid.Column="2"
                Style="{StaticResource VerticalPaneSplitterStyle}" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.25*" MinHeight="230" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" MinHeight="152" />
                </Grid.RowDefinitions>

                <!--  显示面板  -->
                <Border
                    Grid.Row="0"
                    Margin="0"
                    Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="13,11,13,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource GlassSectionIconStyle}">
                                    <Path Width="15" Height="15" Data="{StaticResource Icon.Image}"
                                          Stroke="{DynamicResource Glass.Focus}"
                                          Style="{StaticResource ToolbarIconPathStyle}" />
                                </Border>
                                <TextBlock Text="图像预览" Style="{StaticResource GlassSectionTitleStyle}" />
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox MinHeight="30" VerticalContentAlignment="Center"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding AllWorkflowDisplayOutputs}"
                                          SelectedItem="{Binding SelectedDisplayOutput, Mode=TwoWay}"
                                          mahs:TextBoxHelper.Watermark="选择节点输出"
                                          AutomationProperties.Name="节点输出" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,0" Height="30" MinHeight="30"
                                        Command="{Binding AddDisplaySourceCommand}"
                                        CommandParameter="{Binding SelectedDisplayOutput}"
                                        Style="{StaticResource GlassButtonStyle}" ToolTip="添加到显示源">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Data="{StaticResource Icon.Add}"
                                              Style="{StaticResource ToolbarIconPathStyle}" />
                                        <TextBlock Margin="5,0,0,0" Text="添加" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <!--  HALCON 显示窗口  -->
                        <Border
                            Grid.Row="1"
                            Margin="13,0,13,0" Padding="1"
                            Background="{DynamicResource Theme.Vision.Viewport.Background}"
                            BorderBrush="{DynamicResource Glass.Viewfinder}" BorderThickness="1"
                            CornerRadius="11">
                            <Grid>
                                <ContentControl Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Content="{Binding HWindow}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="16" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Nodes.Count}" Value="0" />
                                                        <Condition Binding="{Binding IsVisionRuntimeAvailable}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Width="24" Height="24" Data="{StaticResource Icon.Image}"
                                          Stroke="{DynamicResource Glass.ViewfinderText}"
                                          Style="{StaticResource ToolbarIconPathStyle}" />
                                    <TextBlock Margin="0,8,0,0" Text="等待图像输出" FontSize="12"
                                               Foreground="{DynamicResource Glass.ViewfinderText}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsVisionRuntimeUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="视觉运行环境未就绪" Foreground="#E1EAF7"
                                               FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding VisionRuntimeMessage}" Foreground="#A9BDD8"
                                               FontSize="12" Margin="0,12,0,0" MaxWidth="340"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="1"
                            MaxWidth="320"
                            Margin="20,12"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{Binding DisplayOverlayBackground}"
                            CornerRadius="6"
                            Visibility="{Binding HasDisplayOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{Binding DisplayOverlayForeground}"
                                Text="{Binding DisplayOverlayText}"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  显示源列表  -->
                        <Border
                            Grid.Row="2"
                            MaxHeight="124"
                            Margin="13,8,13,10"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Glass.Edge}"
                            BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="1,7,1,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding DisplaySources.Count, StringFormat={}{0} 项}"
                                               Style="{StaticResource GlassCaptionStyle}" />
                                    <TextBlock Text="显示源" FontWeight="SemiBold"
                                               Style="{StaticResource GlassCaptionStyle}" />
                                </DockPanel>
                                <ListBox
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding DisplaySources}"
                                    SelectedItem="{Binding SelectedDisplaySource, Mode=TwoWay}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="2,4"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Glass.Edge}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="6,0,6,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Margin="0,0,3,0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Command="{Binding DataContext.MoveDisplaySourceUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SchemeButtonStyle}"
                                                            ToolTip="上移">
                                                            <Path
                                                                Width="12"
                                                                Height="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Data="M3,8 L6,4 L9,8"
                                                                Stretch="None"
                                                                Stroke="{DynamicResource MahApps.Brushes.Text}"
                                                                StrokeLineJoin="Round"
                                                                StrokeThickness="2" />
                                                        </Button>
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Margin="0,0,3,0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Command="{Binding DataContext.MoveDisplaySourceDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SchemeButtonStyle}"
                                                            ToolTip="下移">
                                                            <Path
                                                                Width="12"
                                                                Height="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Data="M3,4 L6,8 L9,4"
                                                                Stretch="None"
                                                                Stroke="{DynamicResource MahApps.Brushes.Text}"
                                                                StrokeLineJoin="Round"
                                                                StrokeThickness="2" />
                                                        </Button>
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="22"
                                                            Padding="0"
                                                            Margin="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Command="{Binding DataContext.RemoveDisplaySourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SchemeButtonStyle}"
                                                            ToolTip="删除">
                                                            <Path
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Data="M4,4 L12,12 M12,4 L4,12"
                                                                Stretch="None"
                                                                Stroke="{DynamicResource Theme.Vision.Status.Failed}"
                                                                StrokeThickness="2" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter
                    Grid.Row="1"
                    Margin="0"
                    Style="{StaticResource HorizontalPaneSplitterStyle}" />

                <!--  底部：TabControl - 模块结果 / 输入绑定  -->
                <Border
                    Grid.Row="2"
                    Margin="0"
                    Style="{StaticResource PanelBorderStyle}">

                    <mahs:MetroTabControl
                        Margin="12,8,12,10"
                        ItemContainerStyle="{StaticResource GlassTabItemStyle}"
                        mahs:TabControlHelper.Underlined="TabPanel"
                        Background="Transparent"
                        BorderThickness="0"
                        Style="{DynamicResource MahApps.Styles.TabControl.Animated}">
                        <mahs:MetroTabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </mahs:MetroTabControl.ItemTemplate>

                        <!--  Tab 1：模块结果  -->
                        <TabItem Header="模块结果">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    Margin="2,4,0,4"
                                    MaxHeight="58"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Theme.Vision.Text.Secondary}"
                                        Text="{Binding ResultMessage}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                                <DataGrid
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    GridLinesVisibility="Horizontal"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding ExecutionRecords}"
                                    SelectedItem="{Binding SelectedExecutionRecord, Mode=TwoWay}"
                                    controls:DataGridAutoScrollHelper.AutoScrollToBottom="True"
                                    controls:DataGridAutoScrollHelper.ScrollToSelectedItem="True"
                                    RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="42"
                                            Binding="{Binding Sequence}"
                                            Header="序号" />
                                        <DataGridTextColumn
                                            Width="67"
                                            Binding="{Binding ExecuteTime, StringFormat=HH:mm:ss}"
                                            Header="执行时间" />
                                        <DataGridTextColumn
                                            Width="1.1*" MinWidth="55"
                                            Binding="{Binding Module}"
                                            Header="模块" />
                                        <DataGridTextColumn
                                            Width="51"
                                            Binding="{Binding StatusText}"
                                            Header="状态" />
                                        <DataGridTextColumn
                                            Width="60"
                                            Binding="{Binding ElapsedText}"
                                            Header="耗时" />
                                        <DataGridTextColumn
                                            Width="2*" MinWidth="80"
                                            Binding="{Binding ResultData}"
                                            Header="结果数据" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1" Margin="0,30,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="运行流程后在此查看结果" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaptionStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionRecords.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </TabItem>

                        <!--  Tab 2：输入绑定（绑定值优先于算子参数中的手动值）  -->
                        <TabItem Header="输入绑定">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="2,4,0,6"
                                    FontSize="11"
                                    Foreground="{DynamicResource Theme.Vision.Text.Secondary}"
                                    Text="已设置绑定的参数在执行时优先使用上游节点的输出值。"
                                    TextWrapping="Wrap" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedInputBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{DynamicResource Glass.Input}"
                                                    BorderBrush="{DynamicResource Glass.Edge}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Margin="0,0,0,4"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource Theme.Vision.Text.Primary}"
                                                            Text="{Binding InputName}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Description}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="52" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox
                                                                MinHeight="26"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding Options}"
                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding ClearCommand}"
                                                                Content="清除" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </mahs:MetroTabControl>
                </Border>
            </Grid>
        </Grid>

        
        <Border Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource GlassDockStyle}" Padding="10,2">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                            Height="24" ToolTip="缩小画布" AutomationProperties.Name="缩小画布">
                        <Path Width="11" Height="11" Data="{StaticResource Icon.ZoomOut}"
                              Style="{StaticResource ToolbarIconPathStyle}" />
                    </Button>
                    <Button Command="{Binding ZoomResetCommand}" Style="{StaticResource GlassButtonStyle}"
                            MinWidth="51" MinHeight="24" Height="24" Padding="6,0" ToolTip="重置画布缩放">
                        <TextBlock Text="{Binding WorkflowScale, StringFormat={}{0:0%}}" />
                    </Button>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource GlassQuietIconButtonStyle}"
                            Height="24" ToolTip="放大画布" AutomationProperties.Name="放大画布">
                        <Path Width="11" Height="11" Data="{StaticResource Icon.ZoomIn}"
                              Style="{StaticResource ToolbarIconPathStyle}" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Theme.Vision.Status.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Theme.Vision.Status.Running}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVisionRuntimeUnavailable}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Theme.Vision.Status.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock ToolTip="{Binding VisionRuntimeMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaptionStyle}">
                                <Setter Property="Text" Value="就绪" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                        <Setter Property="Text" Value="流程运行中" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVisionRuntimeUnavailable}" Value="True">
                                        <Setter Property="Text" Value="HALCON 未就绪" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding SchemeName}" ToolTip="{Binding SchemeTitle}"
                           Style="{StaticResource GlassCaptionStyle}" />
            </DockPanel>
        </Border>

        <!-- AI 助手抽屉 (Copilot & MCP) -->
        <Border
            Grid.RowSpan="3"
            Width="420"
            HorizontalAlignment="Right"
            Panel.ZIndex="35"
            Background="{DynamicResource Glass.Popup}"
            BorderBrush="{DynamicResource Glass.Edge}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="0,0,0,0"
            Visibility="{Binding IsCopilotOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:VisionCopilotPanel DataContext="{Binding Copilot}" />
        </Border>

        
        <Border
            Grid.RowSpan="3"
            Background="{DynamicResource Theme.Vision.Overlay.Background}"
            Panel.ZIndex="50"
            Visibility="{Binding IsSchemeLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="StackPanel.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="SchemeLoadingRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0"
                                        To="360"
                                        Duration="0:0:1.1" />
                                    <DoubleAnimation
                                        AutoReverse="True"
                                        Storyboard.TargetName="SchemeLoadingPulse"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0.35"
                                        To="0.9"
                                        Duration="0:0:0.65" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Grid Width="78" Height="78">
                        <Ellipse
                            Stroke="{DynamicResource MahApps.Brushes.Text}"
                            StrokeThickness="8" />
                        <Ellipse
                            Stroke="{DynamicResource Theme.Vision.Status.Running}"
                            StrokeDashArray="0.42,1.35"
                            StrokeDashCap="Round"
                            StrokeThickness="8">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SchemeLoadingRotate" CenterX="39" CenterY="39" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="SchemeLoadingPulse"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Theme.Vision.Status.Success}" />
                    </Grid>
                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding SchemeLoadingMessage}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Vision.Text.Muted}"
                        Text="请稍候，正在重建流程画布和节点绑定" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



